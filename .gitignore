__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/
next.user-config.*

# Environment variables
.env*.local

# Common ignores
node_modules
.next/
.DS_Store

# Build artifacts (avoid huge binaries being scanned by Tailwind/webpack)
dist/
release/
release-build/
build-output/
dist-app/
out/
android/
android-app/
.git/

# Generated Next standalone server (regenerated by npm run build:server)
/server/

# Logs and build metadata
*.log
*.tsbuildinfo

# Installers / binaries
*.apk
*.rar
rustup-init.exe

# Temp / scratch files
temp_features/
nova-app.js
nova-content.html
nova-fetch.ps1
extract_docx.ps1
test-oss-sign.js
# Packaged app outputs (timestamped)
dist-app-*/

# Scratch scripts / binaries under build
build/_*
build/icon-preview.png
build/icon-zoom.png

# Tool working dirs
.workbuddy/
.arts/
