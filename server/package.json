{
  "name": "focusflow",
  "version": "1.0.0",
  "description": "专注时间管理应用",
  "main": "electron/main.js",
  "author": "FocusFlow",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "export": "set BUILD_MODE=tauri && set NODE_OPTIONS=--max-old-space-size=4096 && next build",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && npm run build:server && electron-builder",
    "electron:build:win": "npm run build && npm run build:server && electron-builder --win --x64",
    "electron:build:mac": "npm run build && npm run build:server && electron-builder --mac",
    "build:server": "node scripts/build-server.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build"
  },
  "build": {
    "appId": "com.focusflow.app",
    "productName": "FocusFlow",
    "directories": {
      "output": "dist-app",
      "buildResources": "build"
    },
    "publish": {
      "provider": "generic",
      "url": "https://example.com/focusflow-releases/"
    },
    "files": [
      "electron/**/*",
      ".next/static/**/*",
      ".next/server/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": false,
    "compression": "maximum",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false,
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FocusFlow",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "3.10.0",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-alert-dialog": "1.1.15",
    "@radix-ui/react-aspect-ratio": "1.1.8",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-context-menu": "2.2.16",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-hover-card": "1.1.15",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-menubar": "1.1.16",
    "@radix-ui/react-navigation-menu": "1.2.14",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-scroll-area": "1.2.10",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-toast": "1.2.15",
    "@radix-ui/react-toggle": "1.1.10",
    "@radix-ui/react-toggle-group": "1.1.11",
    "@radix-ui/react-tooltip": "1.2.8",
    "@supabase/supabase-js": "2.107.0",
    "@vercel/analytics": "1.6.1",
    "autoprefixer": "10.5.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "date-fns": "4.1.0",
    "electron-updater": "6.8.9",
    "embla-carousel-react": "8.6.0",
    "firebase": "12.13.0",
    "input-otp": "1.4.2",
    "lucide-react": "0.564.0",
    "next": "16.2.0",
    "next-themes": "0.4.6",
    "react": "19.2.5",
    "react-day-picker": "9.13.2",
    "react-dom": "19.2.5",
    "react-hook-form": "7.72.1",
    "react-resizable-panels": "2.1.9",
    "recharts": "2.15.0",
    "sonner": "1.7.4",
    "tailwind-merge": "3.5.0",
    "vaul": "1.1.2",
    "zod": "3.25.76",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.2",
    "@tauri-apps/cli": "2.10.1",
    "@types/node": "22.19.17",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "concurrently": "9.2.1",
    "electron": "41.2.1",
    "electron-builder": "26.8.1",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "postcss": "8.5.10",
    "sharp": "0.34.5",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "wait-on": "8.0.5"
  }
}
